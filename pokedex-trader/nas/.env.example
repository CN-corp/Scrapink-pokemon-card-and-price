# Port du NAS sur lequel le site répond en local (http://IP-DU-NAS:8088).
# Changer s'il est déjà pris par un autre projet.
WEB_PORT=8088

# Jeton du tunnel Cloudflare (Zero Trust > Networks > Tunnels > Create > Docker).
# Dans Cloudflare, faire pointer le nom de domaine vers : http://web:80
# Ce fichier est secret : ne pas le partager.
CLOUDFLARE_TUNNEL_TOKEN=
