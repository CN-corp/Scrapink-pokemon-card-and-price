# Moteur Pokédex Trader : variables d'environnement (copier en .env, ne jamais committer le .env).
# Python 3.9+ uniquement, aucune dépendance.

# --- Obligatoire pour publier vers le site (publish-site). Sans elles, publish-site ne fait rien (code 0).
SUPABASE_URL=https://abcdefgh.supabase.co
# Clé SECRÈTE service_role (Supabase > Project Settings > API). Jamais dans le site, jamais dans git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Facultatif
# Emplacement de la base SQLite (défaut : moteur/data/pokemon_trading.db). Mettre sur un volume persistant.
PTRADER_DB=
# Dossier des rapports mensuels (défaut : moteur/reports)
PTRADER_REPORTS=
# Clé pokemontcg.io, seulement pour l'ancienne commande "sync" (plus utilisée au quotidien)
POKEMONTCG_API_KEY=
# Seuils d'analyse (valeurs par défaut choisies par Corentin)
PTRADER_MIN_PRICE=50
PTRADER_HISTORY_MIN=50
PTRADER_DAILY_MIN=5
PTRADER_MAX_WEIGHT=0.15
PTRADER_SELL_FEE_PCT=0.05
PTRADER_SELL_FIXED_FEE=1.20
# 1 = afficher sur les cartes FR la cote Cardmarket « toutes langues » (présentée comme telle). Défaut 0.
PTRADER_FR_CARDMARKET=0
